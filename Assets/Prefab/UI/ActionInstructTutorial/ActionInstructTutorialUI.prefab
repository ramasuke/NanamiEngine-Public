                            }
                        }
                    },
                    "clearText_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483659,
                                "data": {
                                    "value0": {
                                        "value_": "36240EE6-5CBA-4D53-9F69-DE71E3257539"
                                    }
                                }
                            }
                        }
                    },
                    "stepCount": 9,
                    "step_0": {
                        "cereal_class_version": 0,
                        "title_": "歩く",
                        "body_": "まずは歩いてみろ。\n足で地を掴む感覚を忘れるな。"
                    },
                    "step_1": {
                        "title_": "跳ぶ",
                        "body_": "段差も岩場も、跳べば越えられる。"
                    },
                    "step_2": {
                        "title_": "斬る",
                        "body_": "斧を振れ。続けて入力すれば三段まで繋がる。"
                    },
                    "step_3": {
                        "title_": "溜める",
                        "body_": "押し続けて力を溜め、\n離して叩きつけろ。"
                    },
                    "step_4": {
                        "title_": "駆ける",
                        "body_": "駆ければ速い。ただしスタミナを食う。"
                    },
                    "step_5": {
                        "title_": "駆け抜けざまに斬る",
                        "body_": "走りながら斬れ。間合いを一気に詰められる。"
                    },
                    "step_6": {
                        "title_": "転がる",
                        "body_": "攻撃は避けろ。\n転がっている間は刃が当たらん。"
                    },
                    "step_7": {
                        "title_": "跳んで叩く",
                        "body_": "跳んでから斬れ。上から潰す一撃だ。"
                    },
                    "step_8": {
                        "title_": "敵を見据える",
                        "body_": "狙いを定めれば、\n敵を向いたまま動ける。"
                    },
                    "stepLabelPrefix_": "訓練",
                    "clearedText_": "よし！",
                    "anchorOffset_px_": {
                        "value0": 406.0,
                        "value1": 0.0
                    },
                    "fallbackPos_px_": {
                        "value0": 542.0,
                        "value1": 540.0
                    },
