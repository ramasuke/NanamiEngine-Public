                    "guid_": {
                        "cereal_class_version": 0,
                        "value_": "4B8358E3-9669-4AE3-87D8-4467F273DC3D"
                    }
                },
                "count": 5,
                "item_0": {
                    "cereal_class_version": 0,
                    "font_": {
                        "cereal_class_version": 0,
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483650,
                                "data": {
                                    "cereal_class_version": 0,
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "……来たんだ。\nこの骨、見せたかったんだよね。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "北の城塞は、私の故郷の島。\nあの古竜に、心臓を奪われて落ちた。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "落ちたとき、割れた島の底から\nこの骨が出てきた。……竜の骨だよ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "でも見て。頭と胸の骨が無い。\n……砂の跡が、城塞へ続いてる。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "落ちてきた心臓が、この骨を呼んだんだ。\n……眠らせてあげて。お願い。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
}