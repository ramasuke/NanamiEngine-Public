{
    "value0": {
        "polymorphic_id": 2147483649,
        "polymorphic_name": "NanamiEngine::Module::Asset::NpcChat",
        "ptr_wrapper": {
            "id": 2147483649,
            "data": {
                "cereal_class_version": 0,
                "value0": {
                    "cereal_class_version": 0,
                    "value0": {
                        "cereal_class_version": 0
                    },
                    "contentPath_": "Assets\\Data\\NpcChatText/Instructor_Epilogue.npcChat",
                    "guid_": {
                        "cereal_class_version": 0,
                        "value_": "5BA5141C-E3CD-41E9-B3E6-A72C2F40DDC8"
                    }
                },
                "count": 9,
                "item_0": {
                    "cereal_class_version": 0,
                    "font_": {
                        "cereal_class_version": 0,
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483650,
                                "data": {
                                    "cereal_class_version": 0,
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "……戻ったか。\nよく、生きて帰ってきた。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "見ろ。雲の下から、島がいくつも\n浮かび上がってきている。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "巣から散った心臓が、沈んでいた島を\n一つずつ引き上げたんだろう。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "……巣に刺さっていた銛、見たか。\nあれは、俺たちハンターの銛だ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "昔のハンターは、竜を狩る者だった。\n島の心臓は、その竜から奪ったものだ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_5": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483655,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "この島は竜狩りの本拠だった。\n大砲が竜撃ちの砲なのも、そのせいだ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_6": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483656,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "俺たちは、竜の犠牲の上に暮らしてる。\n……それを、今度こそ忘れずに伝えていく。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_7": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483657,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "浮かび上がった島々には、まだ誰も\n渡ったことがない。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_8": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483658,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "新しい狩り場だ。この島もまた、\n駆け出しの島に戻る。……頼んだぞ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
}