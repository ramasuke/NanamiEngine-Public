                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "ようこそ、泉へ。……と言っても、\nもう水はほとんど残っていません。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "泉は北の城塞の下から\n湧いているんです。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "光る石が落ちてから、地の底が\n熱を帯びたみたいで……。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "このままでは、あと幾日も\nもちません。どうか、急いで。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
