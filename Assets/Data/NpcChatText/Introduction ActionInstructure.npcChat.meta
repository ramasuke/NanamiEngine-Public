                },
                "count": 5,
                "item_0": {
                    "cereal_class_version": 0,
                    "font_": {
                        "cereal_class_version": 0,
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483650,
                                "data": {
                                    "cereal_class_version": 0,
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "お前が今日の船で着いた新入りか。\n話は聞いている。",
                    "textColor_": {
                        "cereal_class_version": 0,
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_1": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483651,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "俺はこの島で、駆け出しのハンターに\n戦い方を叩き込んでいる教官だ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_2": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483652,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "よその島の狩り場には、魔物がうろつく。\nそれを狩って稼ぐのがハンターだ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_3": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483653,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "ここらの空じゃ、魔物は待ってくれん。\n着いたその日から訓練を始める。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                },
                "item_4": {
                    "font_": {
                        "value0": {
                            "polymorphic_id": 1073741824,
                            "ptr_wrapper": {
                                "id": 2147483654,
                                "data": {
                                    "value0": {
                                        "value_": "02951627-F120-4EDC-B4F7-C27985C7F643"
                                    }
                                }
                            }
                        }
                    },
                    "text_": "ついて来い。\nまずは体の動かし方からだ。",
                    "textColor_": {
                        "r_": 255,
                        "g_": 255,
                        "b_": 255
                    }
                }
            }
        }
    }
}